# site-cash-recon 私有密钥（复制为数据目录下的 secrets.env，权限 0600，切勿提交或外发）
ZTO_CLI_PRIMARY_URL=http://<主 zto-cli 地址>:9800
ZTO_CLI_PRIMARY_KEY=<主 API Key>
ZTO_CLI_FALLBACK_URL=http://<备 zto-cli 地址>:9800
ZTO_CLI_FALLBACK_KEY=<备 API Key>

# 知识库 Agent 令牌
ZTO_KB_AGENT_TOKEN=<token>

# SMTP（delivery.mail.method = smtp 时）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 大模型分析（analysis.llm = true 时）
ANTHROPIC_API_KEY=
