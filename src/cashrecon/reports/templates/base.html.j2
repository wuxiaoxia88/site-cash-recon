<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="color-scheme" content="light only">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ v.title }}｜{{ v.site }}｜{{ v.period_label }}</title>
<style>
:root{--ink:#1f2328;--muted:#57606a;--line:#d0d7de;--bg:#f6f8fa;--card:#fff;--brand:#0a4da2;
--pos:#1a7f37;--neg:#cf222e;--warn:#9a6700;--high:#cf222e;--medium:#bc4c00;--low:#57606a}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.6 -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei","Segoe UI",sans-serif}
.wrap{max-width:980px;margin:0 auto;padding:16px}
header.top{background:var(--brand);color:#fff;border-radius:10px;padding:16px 20px;margin-bottom:12px}
header.top h1{margin:0;font-size:20px}
header.top .sub{opacity:.9;font-size:13px;margin-top:4px}
.badge{display:inline-block;padding:1px 8px;border-radius:10px;font-size:12px;font-weight:600;background:#fff;color:var(--brand);margin-left:6px}
.badge.PARTIAL{background:#fff8c5;color:var(--warn)}.badge.MISSING{background:#ffebe9;color:var(--neg)}
.headline{background:var(--card);border-left:4px solid var(--brand);border-radius:8px;padding:12px 16px;font-size:16px;font-weight:600;margin-bottom:12px}
section{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin-bottom:12px}
section h2{font-size:16px;margin:0 0 10px;padding-bottom:6px;border-bottom:1px solid var(--line)}
section h3{font-size:14px;margin:12px 0 6px;color:var(--muted)}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:12px}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.kpi .label{color:var(--muted);font-size:12px}.kpi .value{font-size:20px;font-weight:700;font-variant-numeric:tabular-nums}
.kpi .hint{font-size:12px;color:var(--muted)}
@media (max-width:720px){.kpis{grid-template-columns:repeat(2,1fr)}.wrap{padding:10px}}
table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
th,td{padding:6px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
th{font-size:12px;color:var(--muted);font-weight:600;background:var(--bg)}
td.n,th.n{text-align:right;white-space:nowrap}
tr.total td{font-weight:700;border-top:2px solid var(--line)}
.scroll{overflow-x:auto}
.neg{color:var(--neg)}.pos{color:var(--pos)}.muted{color:var(--muted)}.small{font-size:12px}
.tag{display:inline-block;padding:0 6px;border-radius:4px;font-size:12px;border:1px solid var(--line);color:var(--muted);white-space:nowrap}
.tag.ok{border-color:#aceebb;background:#dafbe1;color:var(--pos)}.tag.bad{border-color:#ffcecb;background:#ffebe9;color:var(--neg)}
.tag.warn{border-color:#f5e0a0;background:#fff8c5;color:var(--warn)}
.items{list-style:none;margin:0;padding:0}
.items li{border:1px solid var(--line);border-left-width:4px;border-radius:8px;padding:8px 12px;margin-bottom:8px}
.items li.high{border-left-color:var(--high)}.items li.medium{border-left-color:var(--medium)}.items li.low{border-left-color:var(--low)}
.items .t{font-weight:600}.items .lv{font-size:12px;font-weight:700;margin-right:6px}
.items li.high .lv{color:var(--high)}.items li.medium .lv{color:var(--medium)}.items li.low .lv{color:var(--low)}
.items .act{font-size:13px;color:var(--brand)}
details summary{cursor:pointer;color:var(--muted);font-size:12px}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media (max-width:720px){.cols{grid-template-columns:1fr}}
.share{display:inline-block;width:60px;height:6px;background:var(--bg);border-radius:3px;vertical-align:middle;margin-left:6px}
.share span{display:block;height:6px;border-radius:3px}
.analysis p{margin:6px 0}.analysis b{color:var(--brand)}
footer{color:var(--muted);font-size:12px;padding:8px 4px 24px}
@media print{body{background:#fff}.wrap{max-width:none}section,.kpi{break-inside:avoid}}
</style>
</head>
<body>
<div class="wrap">
<header class="top">
  <h1>{{ v.title }} · {{ v.site }}</h1>
  <div class="sub">{{ v.period_label }}
    {% if v.p is defined %}<span class="badge {{ v.p.data_status }}">数据{{ {"OK":"完整","PARTIAL":"部分不完整","MISSING":"有缺失"}[v.p.data_status] }}</span>{% endif %}
    · 数据计算于 {{ v.generated_at }}</div>
</header>
<div class="headline">{{ v.headline }}</div>
{% block body %}{% endblock %}
<footer>
  口径：现金口径经营利润 = 已分类的经营收入 − 经营成本（中天账户按门户结算科目；线下账户按日记账科目与银行/支付宝分类，去重后计）；
  账户间划转、中天充值/提现、代收代付不计入利润；未分类金额单列。“已核对”表示该账户期末余额有独立来源印证，“仅账面”表示只有单一来源。
  {% if v.kb_link %}<br>在线查看：{{ v.kb_link }}{% endif %}
  <br>内部资料，请勿外传。site-cash-recon
</footer>
</div>
</body>
</html>
