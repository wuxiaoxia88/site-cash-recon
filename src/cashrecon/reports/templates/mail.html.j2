<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="color-scheme" content="light only"><meta name="viewport" content="width=device-width, initial-scale=1"></head>
<body style="margin:0;padding:12px;background:#ffffff;color:#1f2328">
<div style="font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;color:#1f2328;max-width:640px;font-size:14px;line-height:1.6">
<div style="background:#0a4da2;color:#fff;padding:12px 16px;border-radius:8px">
  <div style="font-size:17px;font-weight:700">{{ v.title }} · {{ v.site }}</div>
  <div style="font-size:13px;opacity:.9">{{ v.period_label }}{% if status %} · 数据{{ status }}{% endif %}</div>
</div>
<p style="font-size:15px;font-weight:600;margin:12px 0">{{ v.headline }}</p>
<table style="border-collapse:collapse;width:100%;margin-bottom:10px">
{% for label, value in kpis %}<tr><td style="padding:4px 8px;border-bottom:1px solid #d0d7de;color:#57606a">{{ label }}</td>
<td style="padding:4px 8px;border-bottom:1px solid #d0d7de;text-align:right;font-weight:600">{{ value }}</td></tr>{% endfor %}
</table>
{% if v['items'] %}<div style="font-weight:700;margin:10px 0 4px">需要处理</div>
{% for i in v['items'][:8] %}<div style="border-left:4px solid {{ {'high':'#cf222e','medium':'#bc4c00','low':'#57606a'}[i.level] }};padding:4px 10px;margin-bottom:6px;background:#f6f8fa">
<b>[{{ i.level_cn }}]</b> {{ i.title }}{% if i.detail %}<br><span style="font-size:12px;color:#57606a">{{ i.detail }}</span>{% endif %}
{% if i.action %}<br><span style="font-size:12px;color:#0a4da2">建议：{{ i.action }}</span>{% endif %}</div>{% endfor %}
{% if v['items']|length > 8 %}<div style="font-size:12px;color:#57606a">另有 {{ v['items']|length - 8 }} 项，见完整报表。</div>{% endif %}
{% endif %}
<p style="margin-top:12px">{% if link %}在线查看完整报表：<a href="{{ link }}">{{ link }}</a><br>{% endif %}完整报表见附件（可直接用浏览器打开）。</p>
<p style="font-size:12px;color:#57606a">本邮件由 site-cash-recon 自动发送，内部资料请勿外传。</p>
</div>
</body></html>
